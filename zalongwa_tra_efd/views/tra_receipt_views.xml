<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- TRA Receipt Form View -->
    <record id="view_tra_receipt_form" model="ir.ui.view">
        <field name="name">tra.receipt.form</field>
        <field name="model">tra.receipt</field>
        <field name="arch" type="xml">
            <form string="TRA Receipt" create="false">
                <header>
                    <button name="action_print_receipt" type="object"
                            string="Print TRA Receipt" class="btn-primary"
                            icon="fa-print"
                            invisible="status != 'success'"/>
                    <button name="action_view_qr" type="object"
                            string="Verify on TRA Portal" class="btn-secondary"
                            icon="fa-external-link"
                            invisible="not verify_link"/>
                    <button name="action_mark_failed" type="object"
                            string="Mark as Failed" class="btn-secondary"
                            groups="account.group_account_manager"
                            invisible="status != 'pending' and (status != 'success' or tra_ack_state != 'rejected')"
                            confirm="This allows the invoice to be sent to TRA again as a new receipt. Only continue once you have checked on the WebSHOP portal, or with Zalongwa, that this will not create a duplicate."/>
                    <field name="status" widget="statusbar"
                           statusbar_visible="pending,success,failed"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="DEMO" bg_color="bg-warning"
                            invisible="not is_demo"/>
                    <field name="is_demo" invisible="1"/>
                    <div class="row">
                        <div class="col-md-8">
                            <group>
                                <group string="Receipt Details">
                                    <field name="receipt_number"/>
                                    <field name="verification_code"/>
                                    <field name="receipt_date"/>
                                    <field name="receipt_time"/>
                                    <field name="znum"/>
                                    <field name="vrn"/>
                                    <field name="verify_link" widget="url"/>
                                    <field name="tra_ack_state"/>
                                    <field name="tra_ack_code"/>
                                    <field name="tra_ack_message"/>
                                    <field name="ack_last_check"/>
                                </group>
                                <group string="Source">
                                    <field name="invoice_id_ref"/>
                                    <field name="invoice_date"/>
                                    <field name="account_move_id"/>
                                </group>
                            </group>
                            <group>
                                <group string="Customer">
                                    <field name="customer_name"/>
                                    <field name="customer_id_type"/>
                                    <field name="customer_id_number"/>
                                    <field name="customer_mobile"/>
                                </group>
                                <group string="Amounts">
                                    <field name="total_excl_tax"/>
                                    <field name="total_tax"/>
                                    <field name="total_incl_tax"/>
                                </group>
                            </group>
                        </div>
                        <div class="col-md-4 text-center">
                            <div class="tra-qr-container p-3">
                                <h5 class="text-muted">TRA Verification QR Code</h5>
                                <field name="qr_code_image" widget="image"
                                       options="{'size': [180, 180]}"
                                       invisible="not qr_code_image"/>
                                <div invisible="qr_code_image">
                                    <p class="text-muted"><em>QR code not available</em></p>
                                </div>
                                <div class="mt-2" invisible="not verification_code">
                                    <strong>Code: <field name="verification_code" nolabel="1"/></strong>
                                </div>
                            </div>
                        </div>
                    </div>

                    <notebook>
                        <page string="Items">
                            <field name="item_ids" readonly="1">
                                <list>
                                    <field name="itemcode"/>
                                    <field name="itemdesc"/>
                                    <field name="itemqty"/>
                                    <field name="net"/>
                                    <field name="tax"/>
                                    <field name="amount"/>
                                    <field name="itemtaxcode"/>
                                </list>
                            </field>
                        </page>
                        <page string="API Response" groups="base.group_system">
                            <field name="api_response_raw" readonly="1" widget="text"/>
                        </page>
                        <page string="Error" invisible="not error_message">
                            <field name="error_message" readonly="1" widget="text"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- TRA Receipt List View -->
    <record id="view_tra_receipt_list" model="ir.ui.view">
        <field name="name">tra.receipt.list</field>
        <field name="model">tra.receipt</field>
        <field name="arch" type="xml">
            <list string="TRA Receipts" decoration-danger="status == 'failed'"
                  decoration-success="status == 'success'"
                  decoration-muted="status == 'pending'">
                <field name="receipt_number"/>
                <field name="receipt_date"/>
                <field name="receipt_time"/>
                <field name="invoice_id_ref"/>
                <field name="customer_name"/>
                <field name="verification_code"/>
                <field name="total_excl_tax" sum="Total Excl Tax"/>
                <field name="total_tax" sum="Total VAT"/>
                <field name="total_incl_tax" sum="Total Incl Tax"/>
                <field name="status" widget="badge"
                       decoration-success="status == 'success'"
                       decoration-danger="status == 'failed'"
                       decoration-warning="status == 'pending'"/>
                <field name="tra_ack_state" widget="badge"
                       decoration-success="tra_ack_state == 'confirmed'"
                       decoration-warning="tra_ack_state == 'waiting'"
                       decoration-danger="tra_ack_state == 'rejected'"/>
                <field name="is_demo" optional="show"/>
                <field name="account_move_id" optional="hide"/>
                <button name="action_print_receipt" type="object"
                        icon="fa-print" string="Print"
                        invisible="status != 'success'"/>
            </list>
        </field>
    </record>

    <!-- TRA Receipt Search View -->
    <record id="view_tra_receipt_search" model="ir.ui.view">
        <field name="name">tra.receipt.search</field>
        <field name="model">tra.receipt</field>
        <field name="arch" type="xml">
            <search string="TRA Receipts">
                <field name="receipt_number"/>
                <field name="verification_code"/>
                <field name="customer_name"/>
                <field name="invoice_id_ref"/>
                <separator/>
                <filter string="Success" name="success" domain="[('status','=','success')]"/>
                <filter string="Failed" name="failed" domain="[('status','=','failed')]"/>
                <filter string="Needs Action" name="needs_action"
                        domain="[('status','=','success'),('tra_ack_state','=','rejected')]"/>
                <filter string="Demo Receipts" name="demo" domain="[('is_demo','=',True)]"/>
                <filter string="Today" name="today"
                        domain="[('receipt_date','=', context_today().strftime('%Y-%m-%d'))]"/>
                <group expand="0" string="Group By">
                    <filter string="Status" name="by_status" context="{'group_by': 'status'}"/>
                    <filter string="Date" name="by_date" context="{'group_by': 'receipt_date'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- TRA Receipt Graph View -->
    <record id="view_tra_receipt_graph" model="ir.ui.view">
        <field name="name">tra.receipt.graph</field>
        <field name="model">tra.receipt</field>
        <field name="arch" type="xml">
            <graph string="TRA Receipts" type="bar">
                <field name="receipt_date" interval="day"/>
                <field name="total_incl_tax" type="measure"/>
            </graph>
        </field>
    </record>

    <!-- TRA Receipt Pivot View -->
    <record id="view_tra_receipt_pivot" model="ir.ui.view">
        <field name="name">tra.receipt.pivot</field>
        <field name="model">tra.receipt</field>
        <field name="arch" type="xml">
            <pivot string="TRA Receipts">
                <field name="receipt_date" interval="month" type="row"/>
                <field name="tra_ack_state" type="col"/>
                <field name="total_excl_tax" type="measure"/>
                <field name="total_tax" type="measure"/>
                <field name="total_incl_tax" type="measure"/>
            </pivot>
        </field>
    </record>

    <!-- Action -->
    <record id="action_tra_receipt" model="ir.actions.act_window">
        <field name="name">TRA Receipts</field>
        <field name="res_model">tra.receipt</field>
        <field name="view_mode">list,form,graph,pivot</field>
        <field name="search_view_id" ref="view_tra_receipt_search"/>
        <field name="context">{'search_default_success': 1}</field>
    </record>

</odoo>
