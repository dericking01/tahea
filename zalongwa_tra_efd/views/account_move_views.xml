<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Invoice Form View Inheritance -->
    <record id="view_account_move_tra_form" model="ir.ui.view">
        <field name="name">account.move.tra.form</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">

            <!-- Add TRA button to header -->
            <xpath expr="//header/button[@name='action_post']" position="after">
                <button name="action_generate_tra_receipt" type="object"
                        string="Generate TRA Receipt"
                        class="btn-primary tra-btn-generate"
                        icon="fa-file-text-o"
                        invisible="state != 'posted' or move_type != 'out_invoice' or tra_receipt_status in ('success', 'pending')"/>
                <button name="action_check_tra_receipt" type="object"
                        string="Check TRA Status"
                        class="btn-secondary"
                        icon="fa-refresh"
                        invisible="tra_receipt_status != 'pending'"/>
                <button name="action_refresh_tra_ack" type="object"
                        string="Refresh TRA Response"
                        class="btn-secondary"
                        icon="fa-refresh"
                        invisible="tra_receipt_status != 'success' or tra_ack_state == 'confirmed'"/>
            </xpath>

            <xpath expr="//sheet" position="before">
                <div class="alert alert-danger mb-0" role="alert"
                     invisible="tra_receipt_status != 'success' or tra_ack_state != 'rejected'">
                    <strong>TRA rejected this receipt: </strong>
                    <field name="tra_ack_message" readonly="1"/>
                </div>
            </xpath>

            <xpath expr="//notebook" position="inside">
                <page string="TRA EFD" name="tra_efd" invisible="not tra_receipt_id">
                    <group>
                        <field name="tra_receipt_id"/>
                        <field name="tra_receipt_status"/>
                        <field name="tra_ack_state"/>
                        <field name="tra_receipt_number"/>
                        <field name="tra_verification_code"/>
                        <field name="tra_verify_link" widget="url"/>
                    </group>
                </page>
            </xpath>

        </field>
    </record>

    <!-- Tax Form View - add TRA tax code -->
    <record id="view_account_tax_tra_form" model="ir.ui.view">
        <field name="name">account.tax.tra.form</field>
        <field name="model">account.tax</field>
        <field name="inherit_id" ref="account.view_tax_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='amount_type']" position="after">
                <field name="tra_tax_code"/>
            </xpath>
        </field>
    </record>

    <!-- Invoice Tree View - add TRA columns -->
    <record id="view_account_move_tra_tree" model="ir.ui.view">
        <field name="name">account.move.tra.tree</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_out_invoice_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='invoice_date_due']" position="after">
                <field name="tra_receipt_number" optional="hide" string="TRA Receipt #"/>
                <field name="tra_receipt_status" optional="show" widget="badge"
                       decoration-success="tra_receipt_status == 'success'"
                       decoration-danger="tra_receipt_status == 'failed'"
                       string="TRA Status"/>
                <field name="tra_ack_state" optional="hide" widget="badge"
                       decoration-success="tra_ack_state == 'confirmed'"
                       decoration-warning="tra_ack_state == 'waiting'"
                       decoration-danger="tra_ack_state == 'rejected'"
                       string="TRA Response"/>
            </xpath>
        </field>
    </record>

</odoo>
