<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form_inherit_hdimex_product_location" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.hdimex.product.location</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="product_location_id" class="hdimex_product_location" options="{'no_create': True}"
                       readonly="state in ['cancel', 'sale', 'done']"/>
            </xpath>
        </field>
    </record>
</odoo>
