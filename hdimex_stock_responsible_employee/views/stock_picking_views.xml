<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_picking_form_inherit_hdimex_responsible_employee" model="ir.ui.view">
        <field name="name">stock.picking.form.inherit.hdimex.responsible.employee</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='extra']//field[@name='user_id']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//page[@name='extra']//field[@name='user_id']" position="after">
                <field name="responsible_employee_id" string="Responsible" widget="many2one_avatar_employee"
                       options="{'no_create': True}"
                       readonly="state in ['cancel', 'done']"/>
            </xpath>
        </field>
    </record>
</odoo>
