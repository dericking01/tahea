<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Show the approval sequence number / code on the printed PDF layout -->
    <template id="report_approval_request_document_inherit_seq"
              inherit_id="approvals.report_aprroval_request_document">
        <xpath expr="//h5[@t-field='o.category_id.name']" position="before">
            <h4 class="mt-2 mb-0" t-if="o.name">
                <span t-field="o.name">EXP/2026/0001</span>
            </h4>
        </xpath>

        <!-- Show the amount together with the approval's currency -->
        <xpath expr="//h6[@t-field='o.amount']" position="attributes">
            <attribute name="t-options">{'widget': 'monetary', 'display_currency': o.currency_id or o.company_id.currency_id}</attribute>
        </xpath>
    </template>

</odoo>
