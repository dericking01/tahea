<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_real_estate" model="ir.module.category">
        <field name="name">Real Estate</field>
        <field name="description">Real Estate Lifecycle &amp; Performance Management roles</field>
        <field name="sequence">5</field>
    </record>

    <!-- Read-only / scoped roles -->
    <record id="group_re_investor" model="res.groups">
        <field name="name">Property Owner / Investor (read-only)</field>
        <field name="category_id" ref="module_category_real_estate"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">Read-only access to the properties where the user is listed as investor, and to the dashboard / reports for those properties.</field>
    </record>
    <record id="group_re_technician" model="res.groups">
        <field name="name">Maintenance Technician</field>
        <field name="category_id" ref="module_category_real_estate"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">Sees and updates only work orders assigned to them and the related property / equipment information.</field>
    </record>
    <record id="group_re_leasing_officer" model="res.groups">
        <field name="name">Leasing Officer</field>
        <field name="category_id" ref="module_category_real_estate"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">Prospects, tenants, draft leases and renewals for authorised properties.</field>
    </record>
    <record id="group_re_property_manager" model="res.groups">
        <field name="name">Property Manager</field>
        <field name="category_id" ref="module_category_real_estate"/>
        <field name="implied_ids" eval="[(4, ref('group_re_leasing_officer')), (4, ref('group_re_technician')), (4, ref('purchase.group_purchase_user'))]"/>
        <field name="comment">Full operational management of the properties where the user is manager or authorised staff.</field>
    </record>
    <record id="group_re_maintenance_manager" model="res.groups">
        <field name="name">Maintenance Manager</field>
        <field name="category_id" ref="module_category_real_estate"/>
        <field name="implied_ids" eval="[(4, ref('group_re_technician')), (4, ref('purchase.group_purchase_user'))]"/>
        <field name="comment">All work orders, equipment and preventive plans of the allowed companies; emergency reviews.</field>
    </record>
    <record id="group_re_procurement" model="res.groups">
        <field name="name">Procurement Officer</field>
        <field name="category_id" ref="module_category_real_estate"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user')), (4, ref('purchase.group_purchase_user'))]"/>
    </record>
    <record id="group_re_accountant" model="res.groups">
        <field name="name">Accountant</field>
        <field name="category_id" ref="module_category_real_estate"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user')), (4, ref('account.group_account_invoice'))]"/>
        <field name="comment">Rental billing, deposits, collections, service charges and financial reports for the allowed companies.</field>
    </record>
    <record id="group_re_finance_manager" model="res.groups">
        <field name="name">Finance Manager</field>
        <field name="category_id" ref="module_category_real_estate"/>
        <field name="implied_ids" eval="[(4, ref('group_re_accountant'))]"/>
        <field name="comment">Approves refunds, deposit refunds and credit notes; may override financial controls (logged).</field>
    </record>
    <record id="group_re_portfolio_manager" model="res.groups">
        <field name="name">Portfolio Manager</field>
        <field name="category_id" ref="module_category_real_estate"/>
        <field name="implied_ids" eval="[(4, ref('group_re_property_manager')), (4, ref('group_re_maintenance_manager'))]"/>
        <field name="comment">Manages the portfolios assigned to them; approves leases and amendments (not their own).</field>
    </record>
    <record id="group_re_investment_manager" model="res.groups">
        <field name="name">Investment Manager</field>
        <field name="category_id" ref="module_category_real_estate"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="group_re_dev_pm" model="res.groups">
        <field name="name">Development Project Manager</field>
        <field name="category_id" ref="module_category_real_estate"/>
        <field name="implied_ids" eval="[(4, ref('group_re_maintenance_manager')), (4, ref('group_re_investment_manager'))]"/>
        <field name="comment">Capital works and investment cases. (The full development/construction module is on the roadmap.)</field>
    </record>
    <record id="group_re_director" model="res.groups">
        <field name="name">Group Property Director</field>
        <field name="category_id" ref="module_category_real_estate"/>
        <field name="implied_ids" eval="[(4, ref('group_re_portfolio_manager')), (4, ref('group_re_finance_manager')), (4, ref('group_re_procurement')), (4, ref('group_re_dev_pm'))]"/>
    </record>
    <record id="group_re_admin" model="res.groups">
        <field name="name">Real Estate Administrator</field>
        <field name="category_id" ref="module_category_real_estate"/>
        <field name="implied_ids" eval="[(4, ref('group_re_director'))]"/>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        <field name="comment">Configuration, approval rules, controls and permissions.</field>
    </record>
</odoo>
