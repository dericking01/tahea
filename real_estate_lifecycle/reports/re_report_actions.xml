<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="paperformat_re_landscape" model="report.paperformat">
        <field name="name">RE A4 Landscape</field>
        <field name="format">A4</field>
        <field name="orientation">Landscape</field>
        <field name="margin_top">20</field>
        <field name="margin_bottom">15</field>
        <field name="margin_left">7</field>
        <field name="margin_right">7</field>
        <field name="header_spacing">15</field>
        <field name="dpi">90</field>
    </record>

    <record id="action_report_re_management" model="ir.actions.report">
        <field name="name">Real Estate Management Report</field>
        <field name="model">re.report.wizard</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">real_estate_lifecycle.report_re_management</field>
        <field name="report_file">real_estate_lifecycle.report_re_management</field>
        <field name="paperformat_id" ref="paperformat_re_landscape"/>
        <field name="print_report_name">'%s' % dict(object._fields['report_type'].selection)[object.report_type]</field>
    </record>

    <record id="action_report_tenant_statement" model="ir.actions.report">
        <field name="name">Tenant Statement</field>
        <field name="model">res.partner</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">real_estate_lifecycle.report_tenant_statement</field>
        <field name="report_file">real_estate_lifecycle.report_tenant_statement</field>
        <field name="print_report_name">'Statement - %s' % object.name</field>
    </record>

    <record id="action_report_service_charge" model="ir.actions.report">
        <field name="name">Service-Charge Reconciliation</field>
        <field name="model">re.service.charge.budget</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">real_estate_lifecycle.report_service_charge</field>
        <field name="report_file">real_estate_lifecycle.report_service_charge</field>
        <field name="paperformat_id" ref="paperformat_re_landscape"/>
        <field name="binding_model_id" ref="model_re_service_charge_budget"/>
        <field name="binding_type">report</field>
    </record>

    <record id="action_report_investment" model="ir.actions.report">
        <field name="name">Investment Appraisal</field>
        <field name="model">re.investment</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">real_estate_lifecycle.report_investment</field>
        <field name="report_file">real_estate_lifecycle.report_investment</field>
        <field name="paperformat_id" ref="paperformat_re_landscape"/>
        <field name="binding_model_id" ref="model_re_investment"/>
        <field name="binding_type">report</field>
    </record>

    <record id="action_report_work_order" model="ir.actions.report">
        <field name="name">Work Order Sheet</field>
        <field name="model">re.work.order</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">real_estate_lifecycle.report_work_order</field>
        <field name="report_file">real_estate_lifecycle.report_work_order</field>
        <field name="binding_model_id" ref="model_re_work_order"/>
        <field name="binding_type">report</field>
    </record>

    <record id="action_report_lease" model="ir.actions.report">
        <field name="name">Lease Summary</field>
        <field name="model">re.lease</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">real_estate_lifecycle.report_lease</field>
        <field name="report_file">real_estate_lifecycle.report_lease</field>
        <field name="binding_model_id" ref="model_re_lease"/>
        <field name="binding_type">report</field>
        <field name="print_report_name">'Lease - %s' % object.name</field>
    </record>
</odoo>
