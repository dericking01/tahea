<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_partner_form_re" model="ir.ui.view">
        <field name="name">res.partner.form.re</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button name="action_re_view_leases" type="object" class="oe_stat_button" icon="fa-file-text-o" invisible="not re_is_tenant" groups="real_estate_lifecycle.group_re_leasing_officer,real_estate_lifecycle.group_re_accountant">
                    <field name="re_lease_count" widget="statinfo" string="Leases"/>
                </button>
                <button name="action_re_view_tickets" type="object" class="oe_stat_button" icon="fa-comments" invisible="not re_is_tenant" groups="real_estate_lifecycle.group_re_leasing_officer">
                    <field name="re_ticket_count" widget="statinfo" string="Requests"/>
                </button>
                <button name="action_re_view_work_orders" type="object" class="oe_stat_button" icon="fa-wrench" invisible="not re_is_contractor" groups="real_estate_lifecycle.group_re_technician,real_estate_lifecycle.group_re_procurement">
                    <field name="re_jobs_assigned" widget="statinfo" string="Jobs"/>
                </button>
            </div>
            <xpath expr="//page[@name='internal_notes']" position="before">
                <page string="Real Estate" name="real_estate" groups="real_estate_lifecycle.group_re_leasing_officer,real_estate_lifecycle.group_re_procurement,real_estate_lifecycle.group_re_accountant,real_estate_lifecycle.group_re_maintenance_manager">
                    <group>
                        <group string="Tenant">
                            <field name="re_is_tenant"/>
                            <field name="re_tenant_type" invisible="not re_is_tenant"/>
                            <field name="re_id_type" invisible="not re_is_tenant"/>
                            <field name="re_id_number" invisible="not re_is_tenant"/>
                            <field name="re_emergency_contact" invisible="not re_is_tenant"/>
                            <field name="re_on_time_rate" invisible="not re_is_tenant"/>
                            <field name="re_avg_days_late" invisible="not re_is_tenant"/>
                            <button name="action_re_print_statement" type="object" string="Print Tenant Statement" class="btn-link" invisible="not re_is_tenant" colspan="2"/>
                        </group>
                        <group string="Contractor / Service Vendor">
                            <field name="re_is_contractor"/>
                            <field name="re_service_category_ids" widget="many2many_tags" invisible="not re_is_contractor"/>
                            <field name="re_registration_number" invisible="not re_is_contractor"/>
                            <field name="re_tin" invisible="not re_is_contractor"/>
                            <field name="re_insurance_provider" invisible="not re_is_contractor"/>
                            <field name="re_insurance_policy" invisible="not re_is_contractor"/>
                            <field name="re_insurance_expiry" invisible="not re_is_contractor"/>
                            <field name="re_is_compliant" invisible="not re_is_contractor"/>
                            <field name="re_compliance_note" invisible="not re_is_contractor or re_is_compliant"/>
                        </group>
                    </group>
                    <group string="Licences &amp; Registrations" invisible="not re_is_contractor">
                        <field name="re_license_ids" nolabel="1" colspan="2">
                            <list editable="bottom" decoration-danger="not is_valid">
                                <field name="license_type"/>
                                <field name="number"/>
                                <field name="authority"/>
                                <field name="grade"/>
                                <field name="issue_date"/>
                                <field name="expiry_date"/>
                                <field name="is_valid"/>
                                <field name="attachment_ids" widget="many2many_binary"/>
                            </list>
                        </field>
                    </group>
                    <group string="Performance" invisible="not re_is_contractor">
                        <group>
                            <field name="re_jobs_completed"/>
                            <field name="re_on_time_completion"/>
                            <field name="re_avg_completion_days"/>
                            <field name="re_repeat_faults"/>
                        </group>
                        <group>
                            <field name="re_avg_rating"/>
                            <field name="re_complaints"/>
                            <field name="re_company_currency_id" invisible="1"/>
                            <field name="re_approved_spend"/>
                            <field name="re_actual_spend"/>
                            <field name="re_cost_variance_pct"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <record id="view_re_tenant_list" model="ir.ui.view">
        <field name="name">res.partner.re.tenant.list</field>
        <field name="model">res.partner</field>
        <field name="priority">60</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="re_tenant_type"/>
                <field name="phone"/>
                <field name="email"/>
                <field name="re_lease_count"/>
                <field name="re_on_time_rate"/>
                <field name="re_avg_days_late"/>
            </list>
        </field>
    </record>

    <record id="action_re_tenant" model="ir.actions.act_window">
        <field name="name">Tenants</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="domain">[('re_is_tenant', '=', True)]</field>
        <field name="context">{'default_re_is_tenant': True, 'res_partner_search_mode': 'customer'}</field>
        <field name="view_ids" eval="[(5, 0, 0), (0, 0, {'view_mode': 'list', 'view_id': ref('view_re_tenant_list')}), (0, 0, {'view_mode': 'kanban'}), (0, 0, {'view_mode': 'form'})]"/>
    </record>
</odoo>
