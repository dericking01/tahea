<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_re_approval_log_list" model="ir.ui.view">
        <field name="name">re.approval.log.list</field>
        <field name="model">re.approval.log</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0" decoration-danger="action in ('rejected', 'override')" decoration-success="action == 'approved'">
                <field name="date"/>
                <field name="document_type"/>
                <field name="document_name"/>
                <field name="action"/>
                <field name="user_id"/>
                <field name="amount"/>
                <field name="rule_id"/>
                <field name="note"/>
                <button name="action_open_document" type="object" icon="fa-external-link" title="Open"/>
            </list>
        </field>
    </record>
    <record id="view_re_approval_log_search" model="ir.ui.view">
        <field name="name">re.approval.log.search</field>
        <field name="model">re.approval.log</field>
        <field name="arch" type="xml">
            <search>
                <field name="document_name"/>
                <field name="user_id"/>
                <filter name="overrides" string="Overrides" domain="[('action', '=', 'override')]"/>
                <filter name="rejections" string="Rejections" domain="[('action', '=', 'rejected')]"/>
                <group>
                    <filter name="g_type" string="Document Type" context="{'group_by': 'document_type'}"/>
                    <filter name="g_user" string="User" context="{'group_by': 'user_id'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="action_re_approval_log" model="ir.actions.act_window">
        <field name="name">Approval Audit Trail</field>
        <field name="res_model">re.approval.log</field>
        <field name="view_mode">list</field>
    </record>

    <record id="view_re_approval_rule_list" model="ir.ui.view">
        <field name="name">re.approval.rule.list</field>
        <field name="model">re.approval.rule</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="document_type"/>
                <field name="name"/>
                <field name="min_amount"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="group_id"/>
                <field name="segregation"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>
    <record id="action_re_approval_rule" model="ir.actions.act_window">
        <field name="name">Approval Rules</field>
        <field name="res_model">re.approval.rule</field>
        <field name="view_mode">list</field>
        <field name="help" type="html"><p>For each document type the active rule with the highest minimum amount not exceeding the document amount applies. Without a matching rule no approval is required.</p></field>
    </record>
</odoo>
