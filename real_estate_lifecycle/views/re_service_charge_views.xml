<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_re_sc_budget_list" model="ir.ui.view">
        <field name="name">re.service.charge.budget.list</field>
        <field name="model">re.service.charge.budget</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="property_id"/>
                <field name="building_id"/>
                <field name="date_from"/>
                <field name="date_to"/>
                <field name="allocation_basis"/>
                <field name="total_budget" sum="Budget"/>
                <field name="total_actual"/>
                <field name="variance"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="state" widget="badge" decoration-success="state in ('applied', 'reconciled')" decoration-warning="state == 'to_approve'"/>
            </list>
        </field>
    </record>

    <record id="view_re_sc_budget_form" model="ir.ui.view">
        <field name="name">re.service.charge.budget.form</field>
        <field name="model">re.service.charge.budget</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_compute_allocation" type="object" string="Compute Allocation" invisible="state not in ('draft', 'approved', 'applied')"/>
                    <button name="action_submit" type="object" string="Submit for Approval" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_approve" type="object" string="Approve" class="btn-primary" invisible="not re_can_approve"/>
                    <button name="action_re_open_reject_wizard" type="object" string="Reject" invisible="not re_can_approve"/>
                    <button name="action_apply_to_leases" type="object" string="Apply to Leases" class="btn-primary" invisible="state not in ('approved', 'applied')"/>
                    <button name="action_reconcile" type="object" string="Year-end Reconciliation" invisible="state != 'applied'" groups="real_estate_lifecycle.group_re_accountant" confirm="Create draft balancing invoices / credit notes for every tenant?"/>
                    <button name="action_print_reconciliation" type="object" string="Print Reconciliation" invisible="state == 'draft'"/>
                    <button name="action_close" type="object" string="Close" invisible="state != 'reconciled'"/>
                    <button name="action_reset_draft" type="object" string="Reset to Draft" invisible="state not in ('rejected', 'to_approve')"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,to_approve,approved,applied,reconciled,closed"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_expenses" type="object" class="oe_stat_button" icon="fa-money" string="Actual Expenses"/>
                    </div>
                    <div class="oe_title"><h1><field name="name" placeholder="Service charge 2027 - Block A"/></h1></div>
                    <field name="re_can_approve" invisible="1"/>
                    <group>
                        <group>
                            <field name="property_id" readonly="state != 'draft'"/>
                            <field name="building_id" readonly="state != 'draft'"/>
                            <field name="date_from" readonly="state != 'draft'"/>
                            <field name="date_to" readonly="state != 'draft'"/>
                            <field name="months"/>
                            <field name="allocation_basis" readonly="state != 'draft'"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                        <group>
                            <field name="total_budget"/>
                            <field name="total_actual"/>
                            <field name="variance" decoration-danger="variance &gt; 0"/>
                            <field name="variance_pct"/>
                            <field name="total_billed"/>
                            <field name="total_collected"/>
                            <field name="landlord_void_share"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Budget Lines" name="lines">
                            <field name="line_ids" readonly="state != 'draft'">
                                <list editable="bottom">
                                    <field name="name"/>
                                    <field name="account_ids" widget="many2many_tags" options="{'no_create': True}"/>
                                    <field name="budget_amount" sum="Budget"/>
                                    <field name="actual_amount" sum="Actual"/>
                                    <field name="variance" sum="Variance"/>
                                    <field name="currency_id" column_invisible="1"/>
                                </list>
                            </field>
                        </page>
                        <page string="Tenant Allocation &amp; Reconciliation" name="alloc">
                            <field name="allocation_ids">
                                <list editable="bottom" create="0">
                                    <field name="unit_id" readonly="1"/>
                                    <field name="lease_id" readonly="1"/>
                                    <field name="tenant_id"/>
                                    <field name="share_pct" sum="Total %" readonly="parent.allocation_basis != 'custom' or parent.state not in ('draft',)"/>
                                    <field name="budget_share" sum="Budget"/>
                                    <field name="monthly_charge"/>
                                    <field name="billed_amount" sum="Billed"/>
                                    <field name="collected_amount" sum="Collected"/>
                                    <field name="actual_share" sum="Actual Share"/>
                                    <field name="balance" sum="Balance"/>
                                    <field name="recon_move_id" readonly="1"/>
                                    <field name="currency_id" column_invisible="1"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="note"/>
                            <group string="Approval">
                                <field name="re_approval_state"/>
                                <field name="re_requested_by_id"/>
                                <field name="re_approved_by_id"/>
                                <field name="re_approved_date"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_re_sc_budget" model="ir.actions.act_window">
        <field name="name">Service Charges</field>
        <field name="res_model">re.service.charge.budget</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create a service-charge budget</p>
            <p>Budget per building, map cost categories to expense accounts, allocate to units, approve, bill tenants monthly and reconcile with actual expenditure at year end.</p>
        </field>
    </record>
</odoo>
