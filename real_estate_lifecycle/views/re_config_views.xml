<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_re_property_type_list" model="ir.ui.view">
        <field name="name">re.property.type.list</field>
        <field name="model">re.property.type</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="category"/>
                <field name="is_land"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>
    <record id="action_re_property_type" model="ir.actions.act_window">
        <field name="name">Property Types</field>
        <field name="res_model">re.property.type</field>
        <field name="view_mode">list</field>
    </record>

    <record id="view_re_lease_type_list" model="ir.ui.view">
        <field name="name">re.lease.type.list</field>
        <field name="model">re.lease.type</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="category"/>
                <field name="default_billing_frequency"/>
                <field name="default_notice_days"/>
                <field name="default_deposit_months"/>
                <field name="fiscal_position_id"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>
    <record id="action_re_lease_type" model="ir.actions.act_window">
        <field name="name">Lease Types</field>
        <field name="res_model">re.lease.type</field>
        <field name="view_mode">list</field>
    </record>

    <record id="view_re_area_unit_list" model="ir.ui.view">
        <field name="name">re.area.unit.list</field>
        <field name="model">re.area.unit</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="factor_to_sqm"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>
    <record id="action_re_area_unit" model="ir.actions.act_window">
        <field name="name">Area Units</field>
        <field name="res_model">re.area.unit</field>
        <field name="view_mode">list</field>
    </record>

    <record id="view_re_asset_category_list" model="ir.ui.view">
        <field name="name">re.asset.category.list</field>
        <field name="model">re.asset.category</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="name"/>
                <field name="expected_life_years"/>
                <field name="default_criticality"/>
                <field name="replacement_threshold_pct"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>
    <record id="action_re_asset_category" model="ir.actions.act_window">
        <field name="name">Asset Categories</field>
        <field name="res_model">re.asset.category</field>
        <field name="view_mode">list</field>
    </record>

    <record id="view_re_maintenance_category_list" model="ir.ui.view">
        <field name="name">re.maintenance.category.list</field>
        <field name="model">re.maintenance.category</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="name"/>
                <field name="service_category_id"/>
                <field name="default_priority"/>
                <field name="target_days"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>
    <record id="action_re_maintenance_category" model="ir.actions.act_window">
        <field name="name">Maintenance Categories</field>
        <field name="res_model">re.maintenance.category</field>
        <field name="view_mode">list</field>
    </record>

    <record id="view_re_service_category_list" model="ir.ui.view">
        <field name="name">re.service.category.list</field>
        <field name="model">re.service.category</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="name"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>
    <record id="action_re_service_category" model="ir.actions.act_window">
        <field name="name">Contractor Service Categories</field>
        <field name="res_model">re.service.category</field>
        <field name="view_mode">list</field>
    </record>

    <record id="view_re_complaint_category_list" model="ir.ui.view">
        <field name="name">re.complaint.category.list</field>
        <field name="model">re.complaint.category</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="name"/>
                <field name="maintenance_category_id"/>
                <field name="is_building_wide"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>
    <record id="action_re_complaint_category" model="ir.actions.act_window">
        <field name="name">Request Categories</field>
        <field name="res_model">re.complaint.category</field>
        <field name="view_mode">list</field>
    </record>
</odoo>
