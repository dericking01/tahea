<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_re_property_search" model="ir.ui.view">
        <field name="name">re.property.search</field>
        <field name="model">re.property</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" filter_domain="['|', ('name', 'ilike', self), ('code', 'ilike', self)]"/>
                <field name="property_type_id"/>
                <field name="portfolio_id"/>
                <field name="region"/>
                <field name="district"/>
                <field name="manager_id"/>
                <field name="legal_owner_id"/>
                <field name="title_number"/>
                <filter name="my" string="My Properties" domain="[('manager_id', '=', uid)]"/>
                <separator/>
                <filter name="operational" string="Operational" domain="[('state', '=', 'active')]"/>
                <filter name="development" string="Under Development" domain="[('state', '=', 'under_development')]"/>
                <filter name="land" string="Land" domain="[('is_land', '=', True)]"/>
                <filter name="buildings" string="Built Property" domain="[('is_land', '=', False)]"/>
                <separator/>
                <filter name="insurance" string="Insurance expired / due" domain="[('insurance_expiry', '&lt;=', (context_today() + relativedelta(days=30)).strftime('%Y-%m-%d'))]"/>
                <filter name="archived" string="Archived" domain="[('active', '=', False)]"/>
                <group>
                    <filter name="g_type" string="Type" context="{'group_by': 'property_type_id'}"/>
                    <filter name="g_category" string="Category" context="{'group_by': 'category'}"/>
                    <filter name="g_portfolio" string="Portfolio" context="{'group_by': 'portfolio_id'}"/>
                    <filter name="g_region" string="Region" context="{'group_by': 'region'}"/>
                    <filter name="g_manager" string="Manager" context="{'group_by': 'manager_id'}"/>
                    <filter name="g_company" string="Company" context="{'group_by': 'company_id'}" groups="base.group_multi_company"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_re_property_list" model="ir.ui.view">
        <field name="name">re.property.list</field>
        <field name="model">re.property</field>
        <field name="arch" type="xml">
            <list string="Properties" decoration-muted="state == 'disposed'">
                <field name="code"/>
                <field name="name"/>
                <field name="property_type_id"/>
                <field name="portfolio_id" optional="show"/>
                <field name="region" optional="show"/>
                <field name="district" optional="hide"/>
                <field name="legal_owner_id" optional="show"/>
                <field name="manager_id" optional="show" widget="many2one_avatar_user"/>
                <field name="building_count" optional="hide" sum="Buildings"/>
                <field name="unit_count" sum="Units"/>
                <field name="occupied_unit_count" optional="show" sum="Occupied"/>
                <field name="occupancy_rate" widget="progressbar" optional="show"/>
                <field name="lettable_area_sqm" sum="Area" optional="show"/>
                <field name="current_valuation" sum="Value" optional="show"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="company_id" groups="base.group_multi_company" optional="show"/>
                <field name="state" widget="badge" decoration-success="state == 'active'" decoration-info="state == 'under_development'"/>
            </list>
        </field>
    </record>

    <record id="view_re_property_kanban" model="ir.ui.view">
        <field name="name">re.property.kanban</field>
        <field name="model">re.property</field>
        <field name="arch" type="xml">
            <kanban class="o_re_property_kanban" sample="1">
                <field name="id"/>
                <field name="currency_id"/>
                <field name="occupancy_rate"/>
                <templates>
                    <t t-name="card" class="flex-row">
                        <aside class="o_kanban_aside_full me-2">
                            <field name="image_128" widget="image" options="{'img_class': 'object-fit-cover'}" alt="Property"/>
                        </aside>
                        <main class="ms-1">
                            <div class="d-flex justify-content-between">
                                <field name="name" class="fw-bold fs-5"/>
                                <field name="state" widget="label_selection" options="{'classes': {'active': 'success', 'draft': 'default', 'under_development': 'info', 'disposed': 'danger'}}"/>
                            </div>
                            <div class="text-muted"><field name="code"/> · <field name="property_type_id"/></div>
                            <div class="text-muted"><field name="region"/> <field name="district"/></div>
                            <div class="mt-1">
                                <span><field name="occupied_unit_count"/> / <field name="unit_count"/> units occupied</span>
                            </div>
                            <field name="occupancy_rate" widget="progressbar"/>
                            <div class="d-flex justify-content-between mt-1">
                                <field name="current_valuation" widget="monetary"/>
                                <field name="manager_id" widget="many2one_avatar_user"/>
                            </div>
                        </main>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_re_property_pivot" model="ir.ui.view">
        <field name="name">re.property.pivot</field>
        <field name="model">re.property</field>
        <field name="arch" type="xml">
            <pivot string="Property Analysis" sample="1">
                <field name="category" type="row"/>
                <field name="unit_count" type="measure"/>
                <field name="occupied_unit_count" type="measure"/>
                <field name="lettable_area_sqm" type="measure"/>
                <field name="current_valuation" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_re_property_form" model="ir.ui.view">
        <field name="name">re.property.form</field>
        <field name="model">re.property</field>
        <field name="arch" type="xml">
            <form string="Property">
                <header>
                    <button name="action_activate" type="object" string="Set Operational" class="btn-primary" invisible="state not in ('draft', 'under_development')"/>
                    <button name="action_set_development" type="object" string="Under Development" invisible="state != 'draft'"/>
                    <button name="%(action_re_land_subdivide_wizard)d" type="action" string="Subdivide into Plots" invisible="not is_land" context="{'default_property_id': id}"/>
                    <button name="action_view_profitability" type="object" string="Income Statement (PDF)" groups="real_estate_lifecycle.group_re_accountant,real_estate_lifecycle.group_re_property_manager,real_estate_lifecycle.group_re_investor"/>
                    <button name="action_dispose" type="object" string="Dispose" invisible="state == 'disposed'" groups="real_estate_lifecycle.group_re_director" confirm="Mark this property as disposed?"/>
                    <button name="action_reset_draft" type="object" string="Reset" invisible="state != 'disposed'" groups="real_estate_lifecycle.group_re_admin"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,active"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_buildings" type="object" class="oe_stat_button" icon="fa-building" invisible="is_land">
                            <field name="building_count" widget="statinfo" string="Buildings"/>
                        </button>
                        <button name="action_view_units" type="object" class="oe_stat_button" icon="fa-th-large">
                            <field name="unit_count" widget="statinfo" string="Units / Plots"/>
                        </button>
                        <button name="action_view_leases" type="object" class="oe_stat_button" icon="fa-file-text-o">
                            <field name="lease_count" widget="statinfo" string="Leases"/>
                        </button>
                        <button name="action_view_tenants" type="object" class="oe_stat_button" icon="fa-users">
                            <field name="tenant_count" widget="statinfo" string="Tenants"/>
                        </button>
                        <button name="action_view_work_orders" type="object" class="oe_stat_button" icon="fa-wrench">
                            <field name="work_order_count" widget="statinfo" string="Work Orders"/>
                        </button>
                        <button name="action_view_equipment" type="object" class="oe_stat_button" icon="fa-cogs">
                            <field name="equipment_count" widget="statinfo" string="Equipment"/>
                        </button>
                        <button name="action_view_exceptions" type="object" class="oe_stat_button text-danger" icon="fa-exclamation-triangle" invisible="not exception_count">
                            <field name="exception_count" widget="statinfo" string="Exceptions"/>
                        </button>
                        <button name="action_view_journal_items" type="object" class="oe_stat_button" icon="fa-line-chart" string="Property Ledger" groups="real_estate_lifecycle.group_re_accountant"/>
                    </div>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <field name="image_1920" widget="image" class="oe_avatar" options="{'preview_image': 'image_128'}"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Msasani Peninsula Apartments"/></h1>
                        <h3><field name="code" placeholder="Code"/></h3>
                    </div>
                    <group>
                        <group string="Classification">
                            <field name="active" invisible="1"/>
                            <field name="is_land" invisible="1"/>
                            <field name="property_type_id" options="{'no_create': True}"/>
                            <field name="category"/>
                            <field name="portfolio_id"/>
                            <field name="condition"/>
                        </group>
                        <group string="Responsibility">
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="managing_partner_id"/>
                            <field name="manager_id" widget="many2one_avatar_user"/>
                            <field name="legal_owner_id"/>
                            <field name="analytic_account_id" groups="analytic.group_analytic_accounting,real_estate_lifecycle.group_re_accountant"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Location" name="location">
                            <group>
                                <group>
                                    <field name="street"/>
                                    <field name="street2"/>
                                    <field name="ward"/>
                                    <field name="district"/>
                                    <field name="region"/>
                                    <field name="city"/>
                                    <field name="country_id"/>
                                </group>
                                <group string="GPS">
                                    <field name="latitude"/>
                                    <field name="longitude"/>
                                </group>
                            </group>
                        </page>
                        <page string="Physical &amp; Value" name="value">
                            <group>
                                <group string="Size">
                                    <label for="land_area"/>
                                    <div class="o_row"><field name="land_area"/><field name="land_area_unit_id" options="{'no_create': True}"/></div>
                                    <label for="built_area" invisible="is_land"/>
                                    <div class="o_row" invisible="is_land"><field name="built_area"/><field name="built_area_unit_id" options="{'no_create': True}"/></div>
                                    <field name="lettable_area_sqm"/>
                                    <field name="construction_date" invisible="is_land"/>
                                </group>
                                <group string="Acquisition &amp; Valuation">
                                    <field name="acquisition_date"/>
                                    <field name="purchase_price"/>
                                    <field name="acquisition_costs"/>
                                    <field name="current_valuation"/>
                                    <field name="last_valuation_date"/>
                                    <field name="currency_id" invisible="1"/>
                                </group>
                            </group>
                            <field name="valuation_ids" context="{'default_property_id': id}">
                                <list editable="bottom" decoration-success="state == 'approved'">
                                    <field name="date"/>
                                    <field name="valuer_id"/>
                                    <field name="method"/>
                                    <field name="purpose"/>
                                    <field name="value" readonly="state == 'approved'"/>
                                    <field name="currency_id" column_invisible="1"/>
                                    <field name="state" widget="badge"/>
                                    <field name="re_can_approve" column_invisible="1"/>
                                    <button name="action_submit" type="object" string="Submit" icon="fa-paper-plane" invisible="state != 'draft'"/>
                                    <button name="action_approve" type="object" string="Approve" icon="fa-check" invisible="not re_can_approve"/>
                                </list>
                            </field>
                        </page>
                        <page string="Ownership" name="ownership">
                            <field name="ownership_ids" context="{'default_property_id': id}">
                                <list editable="bottom" decoration-muted="not is_current">
                                    <field name="owner_id"/>
                                    <field name="role"/>
                                    <field name="percentage"/>
                                    <field name="date_from"/>
                                    <field name="date_to"/>
                                    <field name="reference"/>
                                    <field name="is_current"/>
                                </list>
                            </field>
                            <group string="Access">
                                <field name="user_ids" widget="many2many_tags_avatar" groups="real_estate_lifecycle.group_re_portfolio_manager"/>
                                <field name="investor_user_ids" widget="many2many_tags_avatar" groups="real_estate_lifecycle.group_re_portfolio_manager"/>
                            </group>
                        </page>
                        <page string="Title &amp; Legal" name="title">
                            <group>
                                <group>
                                    <field name="title_type"/>
                                    <field name="title_number"/>
                                    <field name="plot_number"/>
                                    <field name="block_number"/>
                                    <field name="survey_plan_number"/>
                                    <field name="land_use"/>
                                </group>
                                <group>
                                    <field name="title_issue_date"/>
                                    <field name="title_term_years"/>
                                    <field name="title_expiry_date"/>
                                    <field name="annual_land_rent"/>
                                </group>
                            </group>
                            <separator string="Encumbrances"/>
                            <field name="encumbrance_ids" context="{'default_property_id': id}">
                                <list editable="bottom" decoration-muted="state == 'released'">
                                    <field name="encumbrance_type"/>
                                    <field name="holder_id"/>
                                    <field name="amount"/>
                                    <field name="currency_id" column_invisible="1"/>
                                    <field name="reference"/>
                                    <field name="registration_date"/>
                                    <field name="state"/>
                                    <field name="release_date"/>
                                </list>
                            </field>
                        </page>
                        <page string="Insurance" name="insurance">
                            <group>
                                <field name="insurer_id"/>
                                <field name="insurance_policy"/>
                                <field name="insured_value"/>
                                <field name="insurance_expiry"/>
                            </group>
                        </page>
                        <page string="Description" name="description">
                            <field name="description"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_re_property" model="ir.actions.act_window">
        <field name="name">Properties</field>
        <field name="res_model">re.property</field>
        <field name="view_mode">kanban,list,form,pivot</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Register your first property</p>
            <p>Properties can be buildings, estates, malls or undeveloped land. Each property gets an analytic account so that its income and expenses are reported automatically.</p>
        </field>
    </record>

    <record id="action_re_land" model="ir.actions.act_window">
        <field name="name">Land &amp; Plots</field>
        <field name="res_model">re.property</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="domain">[('is_land', '=', True)]</field>
        <field name="context" eval="{'default_property_type_id': ref('real_estate_lifecycle.property_type_land')}"/>
    </record>

    <record id="action_re_portfolio" model="ir.actions.act_window">
        <field name="name">Portfolios</field>
        <field name="res_model">re.portfolio</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_re_portfolio_form" model="ir.ui.view">
        <field name="name">re.portfolio.form</field>
        <field name="model">re.portfolio</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_properties" type="object" class="oe_stat_button" icon="fa-building">
                            <field name="property_count" widget="statinfo" string="Properties"/>
                        </button>
                    </div>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="manager_id" widget="many2one_avatar_user"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group>
                            <field name="unit_count"/>
                            <field name="total_valuation"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                    <field name="description" placeholder="Investment strategy / mandate..."/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_re_portfolio_list" model="ir.ui.view">
        <field name="name">re.portfolio.list</field>
        <field name="model">re.portfolio</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="code"/>
                <field name="manager_id" widget="many2one_avatar_user"/>
                <field name="property_count"/>
                <field name="unit_count"/>
                <field name="total_valuation"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_re_valuation_list" model="ir.ui.view">
        <field name="name">re.property.valuation.list</field>
        <field name="model">re.property.valuation</field>
        <field name="arch" type="xml">
            <list>
                <field name="property_id"/>
                <field name="date"/>
                <field name="valuer_id"/>
                <field name="method"/>
                <field name="purpose"/>
                <field name="value" sum="Total"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="state" widget="badge" decoration-success="state == 'approved'" decoration-warning="state == 'to_approve'"/>
                <field name="re_can_approve" column_invisible="1"/>
                <button name="action_approve" type="object" string="Approve" icon="fa-check" invisible="not re_can_approve"/>
            </list>
        </field>
    </record>

    <record id="action_re_valuation" model="ir.actions.act_window">
        <field name="name">Valuations</field>
        <field name="res_model">re.property.valuation</field>
        <field name="view_mode">list,pivot,graph</field>
    </record>

    <record id="view_re_ownership_list" model="ir.ui.view">
        <field name="name">re.property.ownership.list</field>
        <field name="model">re.property.ownership</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="property_id"/>
                <field name="owner_id"/>
                <field name="role"/>
                <field name="percentage"/>
                <field name="date_from"/>
                <field name="date_to"/>
                <field name="reference"/>
            </list>
        </field>
    </record>

    <record id="action_re_ownership" model="ir.actions.act_window">
        <field name="name">Ownership Register</field>
        <field name="res_model">re.property.ownership</field>
        <field name="view_mode">list,pivot</field>
    </record>
</odoo>
