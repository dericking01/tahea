<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_equipment_form_re" model="ir.ui.view">
        <field name="name">maintenance.equipment.form.re</field>
        <field name="model">maintenance.equipment</field>
        <field name="inherit_id" ref="maintenance.hr_equipment_view_form"/>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button name="action_view_re_work_orders" type="object" class="oe_stat_button" icon="fa-wrench" invisible="not re_property_id">
                    <field name="re_work_order_count" widget="statinfo" string="RE Work Orders"/>
                </button>
            </div>
            <xpath expr="//notebook" position="inside">
                <page string="Building Asset" name="re_asset">
                    <group>
                        <group string="Location">
                            <field name="re_asset_code"/>
                            <field name="re_property_id"/>
                            <field name="re_building_id"/>
                            <field name="re_floor_id"/>
                            <field name="re_unit_id"/>
                        </group>
                        <group string="Characteristics">
                            <field name="re_asset_category_id"/>
                            <field name="re_manufacturer"/>
                            <field name="re_installation_date"/>
                            <field name="re_criticality"/>
                            <field name="re_condition"/>
                            <field name="re_downtime_impact"/>
                            <field name="re_service_contract_id"/>
                            <field name="account_asset_id" groups="account.group_account_invoice"/>
                        </group>
                        <group string="Lifecycle Costs">
                            <field name="re_currency_id" invisible="1"/>
                            <field name="re_replacement_cost"/>
                            <field name="re_expected_life_years"/>
                            <field name="re_age_years"/>
                            <field name="re_remaining_life_years"/>
                            <field name="re_maintenance_cost_total"/>
                            <field name="re_cost_12m"/>
                            <field name="re_expected_future_repair"/>
                            <field name="re_failures_12m"/>
                            <field name="re_downtime_hours"/>
                        </group>
                        <group string="Replacement Analysis (decision support)">
                            <field name="re_recommendation" widget="badge"/>
                            <field name="re_recommendation_reason" nolabel="1" colspan="2"/>
                        </group>
                    </group>
                    <field name="re_work_order_ids" readonly="1">
                        <list>
                            <field name="name"/>
                            <field name="date_request"/>
                            <field name="title"/>
                            <field name="maintenance_type"/>
                            <field name="contractor_id"/>
                            <field name="date_done"/>
                            <field name="actual_cost" sum="Total"/>
                            <field name="currency_id" column_invisible="1"/>
                            <field name="state" widget="badge"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

    <record id="view_re_equipment_list" model="ir.ui.view">
        <field name="name">maintenance.equipment.list.re</field>
        <field name="model">maintenance.equipment</field>
        <field name="priority">50</field>
        <field name="arch" type="xml">
            <list>
                <field name="re_asset_code"/>
                <field name="name"/>
                <field name="re_asset_category_id"/>
                <field name="re_property_id"/>
                <field name="re_building_id" optional="show"/>
                <field name="serial_no" optional="hide"/>
                <field name="re_criticality"/>
                <field name="re_condition"/>
                <field name="re_installation_date" optional="hide"/>
                <field name="warranty_date" optional="show"/>
                <field name="re_maintenance_cost_total"/>
                <field name="re_replacement_cost" optional="show"/>
                <field name="re_currency_id" column_invisible="1"/>
                <field name="re_recommendation" widget="badge" decoration-danger="re_recommendation == 'replace'" decoration-warning="re_recommendation == 'inspect'"/>
            </list>
        </field>
    </record>

    <record id="view_re_equipment_search" model="ir.ui.view">
        <field name="name">maintenance.equipment.search.re</field>
        <field name="model">maintenance.equipment</field>
        <field name="priority">50</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="re_asset_code"/>
                <field name="re_property_id"/>
                <field name="re_building_id"/>
                <field name="re_asset_category_id"/>
                <filter name="critical" string="Critical" domain="[('re_criticality', '=', 'critical')]"/>
                <filter name="poor" string="Poor / Failed" domain="[('re_condition', 'in', ('poor', 'failed'))]"/>
                <group>
                    <filter name="g_property" string="Property" context="{'group_by': 're_property_id'}"/>
                    <filter name="g_cat" string="Category" context="{'group_by': 're_asset_category_id'}"/>
                    <filter name="g_cond" string="Condition" context="{'group_by': 're_condition'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_re_equipment" model="ir.actions.act_window">
        <field name="name">Equipment Register</field>
        <field name="res_model">maintenance.equipment</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="domain">[('re_property_id', '!=', False)]</field>
        <field name="search_view_id" ref="view_re_equipment_search"/>
        <field name="view_ids" eval="[(5, 0, 0), (0, 0, {'view_mode': 'list', 'view_id': ref('view_re_equipment_list')}), (0, 0, {'view_mode': 'kanban'}), (0, 0, {'view_mode': 'form'})]"/>
    </record>

    <record id="action_re_asset_replacement" model="ir.actions.act_window">
        <field name="name">Asset Replacement Analysis</field>
        <field name="res_model">maintenance.equipment</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('re_property_id', '!=', False)]</field>
        <field name="search_view_id" ref="view_re_equipment_search"/>
        <field name="view_ids" eval="[(5, 0, 0), (0, 0, {'view_mode': 'list', 'view_id': ref('view_re_equipment_list')}), (0, 0, {'view_mode': 'form'})]"/>
        <field name="help" type="html"><p>Recommendations are decision support only. Replacement requires a management decision and capital approval.</p></field>
    </record>

    <!-- Preventive plans -->
    <record id="view_re_plan_list" model="ir.ui.view">
        <field name="name">re.maintenance.plan.list</field>
        <field name="model">re.maintenance.plan</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="property_id"/>
                <field name="equipment_id"/>
                <field name="trigger"/>
                <field name="interval_number"/>
                <field name="interval_type"/>
                <field name="next_date"/>
                <field name="technician_id"/>
                <field name="contractor_id"/>
                <field name="compliance_rate" widget="progressbar"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>
    <record id="view_re_plan_form" model="ir.ui.view">
        <field name="name">re.maintenance.plan.form</field>
        <field name="model">re.maintenance.plan</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_generate_now" type="object" string="Generate Due Work Orders" class="btn-primary"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name" placeholder="Quarterly lift service"/></h1></div>
                    <group>
                        <group>
                            <field name="property_id"/>
                            <field name="building_id"/>
                            <field name="equipment_id"/>
                            <field name="category_id"/>
                            <field name="technician_id"/>
                            <field name="contractor_id"/>
                            <field name="estimated_cost"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                        <group>
                            <field name="trigger"/>
                            <label for="interval_number" invisible="trigger != 'time'"/>
                            <div class="o_row" invisible="trigger != 'time'"><field name="interval_number"/><field name="interval_type"/></div>
                            <field name="next_date" invisible="trigger != 'time'"/>
                            <field name="lead_days" invisible="trigger != 'time'"/>
                            <field name="usage_meter_id" invisible="trigger != 'usage'"/>
                            <field name="usage_interval" invisible="trigger != 'usage'"/>
                            <field name="next_usage" invisible="trigger != 'usage'"/>
                            <field name="compliance_rate"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <field name="instructions"/>
                    <field name="work_order_ids" readonly="1">
                        <list>
                            <field name="name"/>
                            <field name="scheduled_date"/>
                            <field name="date_done"/>
                            <field name="state" widget="badge"/>
                        </list>
                    </field>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="action_re_plan" model="ir.actions.act_window">
        <field name="name">Preventive Maintenance</field>
        <field name="res_model">re.maintenance.plan</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
