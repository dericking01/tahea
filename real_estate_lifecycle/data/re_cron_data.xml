<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="cron_re_lease_lifecycle" model="ir.cron">
            <field name="name">Real Estate: Lease lifecycle, expiry alerts and escalations</field>
            <field name="model_id" ref="model_re_lease"/>
            <field name="state">code</field>
            <field name="code">model._cron_lease_lifecycle()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="priority">5</field>
        </record>
        <record id="cron_re_billing" model="ir.cron">
            <field name="name">Real Estate: Rental billing run (idempotent)</field>
            <field name="model_id" ref="model_re_billing_schedule"/>
