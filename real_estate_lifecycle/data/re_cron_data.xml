            <field name="code">model._cron_generate_rental_invoices()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="priority">6</field>
        </record>
        <record id="cron_re_exceptions" model="ir.cron">
            <field name="name">Real Estate: Revenue assurance &amp; control checks</field>
            <field name="model_id" ref="model_re_exception"/>
            <field name="state">code</field>
            <field name="code">model._cron_run_checks()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="priority">8</field>
        </record>
        <record id="cron_re_collections" model="ir.cron">
            <field name="name">Real Estate: Collection cases and promises</field>
            <field name="model_id" ref="model_re_collection_case"/>
