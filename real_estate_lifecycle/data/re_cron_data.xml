            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
        </record>
        <record id="cron_re_preventive" model="ir.cron">
            <field name="name">Real Estate: Preventive maintenance scheduler</field>
            <field name="model_id" ref="model_re_maintenance_plan"/>
            <field name="state">code</field>
            <field name="code">model._cron_generate()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
        </record>
        <record id="cron_re_vendor_contracts" model="ir.cron">
            <field name="name">Real Estate: Vendor contract expiry</field>
            <field name="model_id" ref="model_re_vendor_contract"/>
            <field name="state">code</field>
            <field name="code">model._cron_contract_expiry()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
        </record>
