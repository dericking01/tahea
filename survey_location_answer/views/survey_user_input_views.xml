<?xml version="1.0" encoding="utf-8"?>
<odoo>
<data>

    <!-- Participations list: add Key Answers column after email -->
    <record id="survey_user_input_view_tree_key_answers" model="ir.ui.view">
        <field name="name">survey.user_input.view.list.key_answers</field>
        <field name="model">survey.user_input</field>
        <field name="inherit_id" ref="survey.survey_user_input_view_tree"/>
        <field name="arch" type="xml">
            <field name="email" position="after">
                <field name="configured_answers_summary" string="Key Answers" optional="show"/>
            </field>
        </field>
    </record>

    <!-- Participation form: show individual key answers before the notebook -->
    <record id="survey_user_input_view_form_key_answers" model="ir.ui.view">
        <field name="name">survey.user_input.view.form.key_answers</field>
        <field name="model">survey.user_input</field>
        <field name="inherit_id" ref="survey.survey_user_input_view_form"/>
        <field name="arch" type="xml">
            <notebook position="before">
                <group string="Key Answers"
                    invisible="not configured_answer_ids"
                    name="group_key_answers">
                    <field name="configured_answer_ids" nolabel="1">
                        <list create="false" delete="false">
                            <field name="column_name" string="Field"/>
                            <field name="value" string="Answer"/>
                        </list>
                    </field>
                </group>
            </notebook>
        </field>
    </record>

    <!-- Search view: Group By Key Answers -->
    <record id="survey_user_input_view_search_key_answers" model="ir.ui.view">
        <field name="name">survey.user_input.view.search.key_answers</field>
        <field name="model">survey.user_input</field>
        <field name="inherit_id" ref="survey.survey_user_input_view_search"/>
        <field name="arch" type="xml">
            <filter name="group_by_partner" position="after">
                <filter string="Key Answers" name="group_by_key_answers"
                    domain="[]" context="{'group_by': 'configured_answers_summary'}"/>
            </filter>
        </field>
    </record>

</data>
</odoo>
