<odoo>

   <record id="view_sales_pos_report_wizard_form" model="ir.ui.view">
    <field name="name">sales.pos.report.wizard.form</field>
    <field name="model">sales.pos.report.wizard</field>
    <field name="arch" type="xml">
        <form string="Sales / POS Excel Report">
            <group>
                <field name="start_date"/>
                <field name="end_date"/>
                <field name="report_type"/>
                <field name="cashier_ids" widget="many2many_tags" options="{'no_create': True}" placeholder="Select cashiers..."/>
            </group>
            <footer>
                <button name="action_export_excel" type="object" string="Export Excel" class="btn-primary"/>
                <button string="Cancel" class="btn-secondary" special="cancel"/>
            </footer>
        </form>
    </field>
</record>


    <!-- <menuitem id="menu_sales_pos_excel_root" name="Sales / POS Excel" parent="point_of_sale.menu_point_rep" /> -->
    <menuitem id="menu_sales_pos_excel_wizard" name="SO / PoS Export Report" parent="point_of_sale.menu_point_rep"
              action="action_sales_pos_excel_wizard" sequence="4"/>
</odoo>
