<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="gwambina_extended.StockKanbanRenderer" t-inherit="web.KanbanRenderer" t-inherit-mode="primary">
        <xpath expr="//t[@t-foreach='getGroupsOrRecords()']" position="before">
            <article t-if="gwCustomReceipts.show and !props.list.isGrouped"
                     class="o_kanban_record d-flex flex-grow-1 flex-md-shrink-1 flex-shrink-0 gw_custom_receipts_card"
                     role="article" style="cursor: pointer;"
                     t-on-click="() => this.gwOpenCustomReceipts()">
                <div class="px-2 w-100">
                    <span class="fw-bold fs-4 text-primary">Custom Receipts</span>
                    <div class="text-muted">GRNs to my locations</div>
                    <div class="mt-3">
                        <button class="btn btn-primary">
                            <span t-if="gwCustomReceipts.ready"><t t-esc="gwCustomReceipts.ready"/> To Receive</span>
                            <span t-else="">Open</span>
                        </button>
                    </div>
                </div>
            </article>
        </xpath>
    </t>
</templates>
