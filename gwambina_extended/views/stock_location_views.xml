<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_location_form_gw" model="ir.ui.view">
        <field name="name">stock.location.form.gwambina</field>
        <field name="model">stock.location</field>
        <field name="inherit_id" ref="stock.view_location_form"/>
        <field name="arch" type="xml">
            <field name="replenish_location" position="after">
                <field name="gw_responsible_user_ids" widget="many2many_tags"
                       invisible="usage not in ('internal', 'view')"
                       options="{'no_create': True}"/>
            </field>
        </field>
    </record>
</odoo>
