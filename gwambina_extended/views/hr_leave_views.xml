<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Signature under the description. Inherited by the dashboard and manager forms too. -->
    <record id="hr_leave_view_form_signature" model="ir.ui.view">
        <field name="name">hr.leave.view.form.signature</field>
        <field name="model">hr.leave</field>
        <field name="inherit_id" ref="hr_holidays.hr_leave_view_form"/>
        <field name="arch" type="xml">
            <field name="user_id" position="after">
                <field name="employee_signature" widget="signature"
                       options="{'full_name': 'employee_id', 'size': [0, 120]}"
                       readonly="state != 'confirm'"/>
                <field name="employee_signed_on" invisible="not employee_signed_on"/>
            </field>
        </field>
    </record>
</odoo>
