<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="action_report_statement_invoice" model="ir.actions.report">
        <field name="name">Custom Invoice Report</field>
        <field name="model">statement.invoice.report.wizard</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">custom_invoice_statement_report.invoice_doc</field>
        <field name="report_file">custom_invoice_statement_report.invoice_doc</field>
        <field name="print_report_name">'Custom Invoice Report - %s to %s' % (object.date_from, object.date_to)</field>
        <field name="paperformat_id" ref="paperformat_statement_invoice_report"/>
    </record>

</odoo>
