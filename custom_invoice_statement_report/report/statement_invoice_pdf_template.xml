<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="invoice_doc">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="wizard">
                <t t-set="o" t-value="wizard"/>
                <t t-set="rd" t-value="report_data"/>
                <t t-set="currency" t-value="rd['company_currency']"/>
                <t t-call="web.external_layout">
                    <div class="page" style="font-size: 11px;">

                        <div class="row mt-2 mb-3">
                            <div class="col-12">
                                <h2 style="color:#1F4E78; margin-bottom:2px;"><span t-out="rd['report_title']"/></h2>
                                <div class="text-muted" style="font-size:12px;">
                                    <span t-field="rd['company'].name"/>
                                    &#8212;
                                    Period (by
                                    <span t-out="rd['date_basis_label']"/>):
                                    <span t-out="rd['date_from']" t-options="{'widget': 'date'}"/>
                                    to
                                    <span t-out="rd['date_to']" t-options="{'widget': 'date'}"/>
                                </div>
                                <div class="text-muted" style="font-size:10px;">
                                    Generated on
                                    <span t-out="rd['generated_on']" t-options="{'widget': 'datetime'}"/>
                                </div>
                                <p t-if="rd['date_basis'] == 'payment_date'" class="text-muted" style="font-size:9px; margin-top:4px;">
                                    Filtered by Payment Date: only invoices with at least one payment in this
                                    window are included (unpaid invoices cannot appear). Amounts shown are each
                                    invoice's full value, not just the portion paid within this window.
                                </p>
                            </div>
                        </div>

                        <!-- ============== SUMMARY ============== -->
                        <h4 style="border-bottom: 2px solid #1F4E78; padding-bottom: 3px; color:#1F4E78;">Summary</h4>
                        <table class="table table-sm table-borderless" style="margin-bottom: 4px;">
                            <tbody>
                                <tr>
                                    <td style="width:25%;" class="text-muted">Total Posted Invoices</td>
                                    <td style="width:25%;" class="fw-bold"><span t-out="rd['summary']['invoice_count']"/></td>
                                    <td style="width:25%;" class="text-muted">Total Invoice Amount</td>
                                    <td style="width:25%;" class="fw-bold">
                                        <span t-out="rd['summary']['total_amount']" t-options="{'widget': 'monetary', 'display_currency': currency}"/>
                                    </td>
                                </tr>
                                <tr>
                                    <td class="text-muted">Total Paid Amount</td>
                                    <td class="fw-bold text-success">
                                        <span t-out="rd['summary']['paid_amount']" t-options="{'widget': 'monetary', 'display_currency': currency}"/>
                                    </td>
                                    <td class="text-muted">Total Outstanding Amount</td>
                                    <td class="fw-bold text-danger">
                                        <span t-out="rd['summary']['outstanding_amount']" t-options="{'widget': 'monetary', 'display_currency': currency}"/>
                                    </td>
                                </tr>
                            </tbody>
                        </table>

                        <table class="table table-sm" style="margin-bottom: 14px;">
                            <thead style="display: table-row-group;">
                                <tr style="background-color:#E7EEF5;">
                                    <th>Payment Status</th>
                                    <th class="text-end">Invoice Count</th>
                                    <th class="text-end">Amount</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="['paid', 'partial', 'not_paid', 'other']" t-as="bkey">
                                    <t t-set="b" t-value="rd['summary']['buckets'][bkey]"/>
                                    <tr t-if="bkey != 'other' or b['count']">
                                        <td><span t-out="b['label']"/></td>
                                        <td class="text-end"><span t-out="b['count']"/></td>
                                        <td class="text-end">
                                            <span t-out="b['amount']" t-options="{'widget': 'monetary', 'display_currency': currency}"/>
                                        </td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>

                        <!-- ============== PAYMENT TYPE BREAKDOWN ============== -->
                        <h4 style="border-bottom: 2px solid #1F4E78; padding-bottom: 3px; color:#1F4E78;">
                            Payment Type Breakdown (Cash / Bank)
                        </h4>
                        <table class="table table-sm table-bordered" style="margin-bottom: 4px;">
                            <thead style="display: table-row-group;">
                                <tr style="background-color:#2E75B6; color:white;">
                                    <th>Payment Type</th>
                                    <th class="text-end">Invoice Count</th>
                                    <th class="text-end">Total Invoice Amount</th>
                                    <th class="text-end">Paid</th>
                                    <th class="text-end">Partially Paid</th>
                                    <th class="text-end">Unpaid</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="rd['breakdown_rows']" t-as="row">
                                    <tr style="background-color:#DCE6F1; font-weight:bold;">
                                        <td><span t-out="row['label']"/></td>
                                        <td class="text-end"><span t-out="row['count']"/></td>
                                        <td class="text-end"><span t-out="row['amount']" t-options="{'widget': 'monetary', 'display_currency': currency}"/></td>
                                        <td class="text-end"><span t-out="row['paid_amount']" t-options="{'widget': 'monetary', 'display_currency': currency}"/></td>
                                        <td class="text-end"><span t-out="row['partial_amount']" t-options="{'widget': 'monetary', 'display_currency': currency}"/></td>
                                        <td class="text-end"><span t-out="row['not_paid_amount']" t-options="{'widget': 'monetary', 'display_currency': currency}"/></td>
                                    </tr>
                                    <!-- Only worth a drill-down once a type has more than one
                                         contributing journal; with a single one, the sub-row
                                         would just repeat the subtotal above it. -->
                                    <t t-if="len(rd['journal_rows'][row['key']]) > 1">
                                        <tr t-foreach="rd['journal_rows'][row['key']]" t-as="jrow" style="color:#4d4d4d; font-size:10px;">
                                            <td style="padding-left: 24px;"><span t-out="jrow['label']"/></td>
                                            <td class="text-end"><span t-out="jrow['count']"/></td>
                                            <td class="text-end"><span t-out="jrow['amount']" t-options="{'widget': 'monetary', 'display_currency': currency}"/></td>
                                            <td class="text-end"><span t-out="jrow['paid_amount']" t-options="{'widget': 'monetary', 'display_currency': currency}"/></td>
                                            <td class="text-end"><span t-out="jrow['partial_amount']" t-options="{'widget': 'monetary', 'display_currency': currency}"/></td>
                                            <td class="text-end"><span t-out="jrow['not_paid_amount']" t-options="{'widget': 'monetary', 'display_currency': currency}"/></td>
                                        </tr>
                                    </t>
                                </t>
                                <tr style="background-color:#D9E1F2; font-weight:bold;">
                                    <t t-set="tot" t-value="rd['breakdown_total']"/>
                                    <td><span t-out="tot['label']"/></td>
                                    <td class="text-end"><span t-out="tot['count']"/></td>
                                    <td class="text-end"><span t-out="tot['amount']" t-options="{'widget': 'monetary', 'display_currency': currency}"/></td>
                                    <td class="text-end"><span t-out="tot['paid_amount']" t-options="{'widget': 'monetary', 'display_currency': currency}"/></td>
                                    <td class="text-end"><span t-out="tot['partial_amount']" t-options="{'widget': 'monetary', 'display_currency': currency}"/></td>
                                    <td class="text-end"><span t-out="tot['not_paid_amount']" t-options="{'widget': 'monetary', 'display_currency': currency}"/></td>
                                </tr>
                            </tbody>
                        </table>
                        <p class="text-muted" style="font-size:9px;">
                            Amounts represent total invoice value per payment status (not cash collected to date).
                            Indented rows break each Cash/Bank total down by the specific journal that settled the
                            invoice. An invoice is classified under the single journal that carried the larger share
                            of its reconciled payments, so it is never counted twice.
                        </p>
                        <p t-if="rd['unclassified']['count']" class="text-muted" style="font-size:9px;">
                            Note:
                            <span t-out="rd['unclassified']['count']"/> invoice(s) totalling
                            <span t-out="rd['unclassified']['amount']" t-options="{'widget': 'monetary', 'display_currency': currency}"/>
                            are not settled via a Cash or Bank journal (unpaid, or settled through another journal
                            type) and are excluded from the breakdown table above.
                        </p>

                        <!-- ============== INVOICE DETAIL ============== -->
                        <h4 style="border-bottom: 2px solid #1F4E78; padding-bottom: 3px; color:#1F4E78; page-break-before: always;">
                            Invoice Detail
                        </h4>
                        <table t-if="rd['invoices']" class="table table-sm table-bordered" style="font-size:10px;">
                            <thead style="display: table-row-group;">
                                <tr style="background-color:#2E75B6; color:white;">
                                    <th>Invoice #</th>
                                    <th>Date</th>
                                    <th>Customer</th>
                                    <th>Journal</th>
                                    <th>Payment Type</th>
                                    <th>Settlement Journal</th>
                                    <th class="text-end">Amount</th>
                                    <th class="text-end">Paid</th>
                                    <th class="text-end">Due</th>
                                    <th>Status</th>
                                    <th>Currency</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="rd['invoices']" t-as="line">
                                    <td><span t-out="line['name']"/></td>
                                    <td class="text-nowrap"><span t-out="line['invoice_date']" t-options="{'widget': 'date'}"/></td>
                                    <td style="max-width:140px; overflow-wrap:break-word;"><span t-out="line['partner']"/></td>
                                    <td><span t-out="line['journal']"/></td>
                                    <td><span t-out="line['cash_bank_type']"/></td>
                                    <td><span t-out="line['settlement_journal']"/></td>
                                    <td class="text-end"><span t-out="line['amount_total']" t-options="{'widget': 'monetary', 'display_currency': line['currency_record']}"/></td>
                                    <td class="text-end"><span t-out="line['amount_paid']" t-options="{'widget': 'monetary', 'display_currency': line['currency_record']}"/></td>
                                    <td class="text-end"><span t-out="line['amount_due']" t-options="{'widget': 'monetary', 'display_currency': line['currency_record']}"/></td>
                                    <td><span t-out="line['payment_status']"/></td>
                                    <td><span t-out="line['currency']"/></td>
                                </tr>
                            </tbody>
                        </table>
                        <p t-else="" class="text-muted fst-italic">
                            No posted customer invoices were found for the selected period.
                        </p>

                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
