<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_intercompany_transfer_list" model="ir.ui.view">
        <field name="name">intercompany.stock.transfer.list</field>
        <field name="model">intercompany.stock.transfer</field>
        <field name="arch" type="xml">
            <list string="Inter-Company Transfers" sample="1">
                <field name="name" decoration-bf="1"/>
                <field name="scheduled_date" widget="remaining_days" optional="show" invisible="state in ('received', 'cancel')"/>
                <field name="source_company_id" optional="show"/>
                <field name="source_warehouse_id" optional="show"/>
                <field name="source_location_id" optional="hide"/>
                <field name="dest_company_id" optional="show"/>
                <field name="dest_warehouse_id" optional="show"/>
                <field name="dest_location_id" optional="hide"/>
                <field name="user_id" widget="many2one_avatar_user" optional="show"/>
                <field name="origin" optional="hide"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'confirmed'"
                       decoration-warning="state == 'in_transit'"
                       decoration-success="state == 'received'"
                       decoration-muted="state == 'cancel'"/>
            </list>
        </field>
    </record>

    <record id="view_intercompany_transfer_form" model="ir.ui.view">
        <field name="name">intercompany.stock.transfer.form</field>
        <field name="model">intercompany.stock.transfer</field>
        <field name="arch" type="xml">
            <form string="Inter-Company Transfer">
                <header>
                    <button name="action_confirm" string="Confirm Transfer" type="object" class="oe_highlight"
                            invisible="state != 'draft'" data-hotkey="v"/>
                    <button name="action_check_availability" string="Check Availability" type="object"
                            invisible="not can_dispatch"/>
                    <button name="action_dispatch" string="Dispatch Stock" type="object" class="oe_highlight"
                            invisible="not can_dispatch" data-hotkey="d"/>
                    <button name="action_receive" string="Receive Stock" type="object" class="oe_highlight"
                            invisible="not can_receive" data-hotkey="r"/>
                    <button name="action_cancel" string="Cancel Transfer" type="object"
                            invisible="state in ('received', 'cancel')" data-hotkey="z"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirmed,in_transit,received"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_dispatch_pickings" type="object" class="oe_stat_button"
                                icon="fa-truck" invisible="not dispatch_picking_count">
                            <field name="dispatch_picking_count" widget="statinfo" string="Source Picking"/>
                        </button>
                        <button name="action_view_receipt_pickings" type="object" class="oe_stat_button"
                                icon="fa-download" invisible="not receipt_picking_count">
                            <field name="receipt_picking_count" widget="statinfo" string="Destination Picking"/>
                        </button>
                        <button name="action_view_return_pickings" type="object" class="oe_stat_button"
                                icon="fa-undo" invisible="not return_picking_count">
                            <field name="return_picking_count" widget="statinfo" string="Returns"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <field name="active" invisible="1"/>
                    <field name="can_dispatch" invisible="1"/>
                    <field name="can_receive" invisible="1"/>
                    <field name="allowed_company_ids" invisible="1"/>
                    <field name="company_id" invisible="1"/>
                    <group>
                        <group string="Source" name="source">
                            <field name="source_company_id" readonly="state != 'draft'"
                                   domain="[('id', 'in', allowed_company_ids)]" options="{'no_create': True}"/>
                            <field name="source_warehouse_id" readonly="state != 'draft'" options="{'no_create': True}"/>
                            <field name="source_location_id" readonly="state != 'draft'" options="{'no_create': True}"/>
                        </group>
                        <group string="Destination" name="destination">
                            <field name="dest_company_id" readonly="state != 'draft'"
                                   domain="[('id', 'in', allowed_company_ids), ('id', '!=', source_company_id)]"
                                   options="{'no_create': True}"/>
                            <field name="dest_warehouse_id" readonly="state != 'draft'" options="{'no_create': True}"/>
                            <field name="dest_location_id" readonly="state != 'draft'" options="{'no_create': True}"/>
                        </group>
                        <group name="planning">
                            <field name="scheduled_date" readonly="state in ('received', 'cancel')"/>
                            <field name="user_id" widget="many2one_avatar_user"/>
                        </group>
                        <group name="reference">
                            <field name="origin" placeholder="e.g. Request #123"/>
                            <field name="transit_location_id" groups="stock.group_stock_multi_locations"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Products" name="products">
                            <field name="line_ids" readonly="state != 'draft'" context="{'default_transfer_id': id}">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="company_id" column_invisible="1"/>
                                    <field name="product_uom_category_id" column_invisible="1"/>
                                    <field name="product_tracking" column_invisible="1"/>
                                    <field name="product_id" options="{'no_create': True}"/>
                                    <field name="lot_id" optional="show" options="{'no_create': True}"
                                           invisible="product_tracking == 'none'"
                                           context="{'default_product_id': product_id}"
                                           groups="stock.group_production_lot"/>
                                    <field name="product_uom_qty"/>
                                    <field name="product_uom_id" options="{'no_create': True}" groups="uom.group_uom"/>
                                    <field name="source_qty_available" optional="show"
                                           decoration-danger="source_qty_available &lt; product_uom_qty and parent.state in ('draft', 'confirmed')"/>
                                    <field name="qty_reserved" optional="show"/>
                                    <field name="qty_dispatched" optional="show"/>
                                    <field name="qty_in_transit" optional="show"/>
                                    <field name="qty_received" optional="show"/>
                                    <field name="lot_names" optional="hide" groups="stock.group_production_lot"/>
                                </list>
                            </field>
                        </page>
                        <page string="Remarks" name="remarks">
                            <field name="note" placeholder="Internal remarks..."/>
                        </page>
                        <page string="Traceability" name="traceability">
                            <group>
                                <group string="Confirmation">
                                    <field name="create_uid" string="Initiated By"/>
                                    <field name="create_date" string="Initiated On"/>
                                    <field name="confirm_user_id"/>
                                    <field name="confirm_date"/>
                                </group>
                                <group string="Dispatch &amp; Receipt">
                                    <field name="dispatch_user_id"/>
                                    <field name="dispatch_date"/>
                                    <field name="receive_user_id"/>
                                    <field name="receive_date"/>
                                </group>
                                <group string="Cancellation" invisible="state != 'cancel'">
                                    <field name="cancel_user_id"/>
                                    <field name="cancel_date"/>
                                    <field name="cancel_reason"/>
                                </group>
                            </group>
                            <field name="picking_ids" readonly="1">
                                <list>
                                    <field name="name"/>
                                    <field name="intercompany_role"/>
                                    <field name="company_id" groups="base.group_multi_company"/>
                                    <field name="location_id"/>
                                    <field name="location_dest_id"/>
                                    <field name="date_done"/>
                                    <field name="state" widget="badge"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_intercompany_transfer_search" model="ir.ui.view">
        <field name="name">intercompany.stock.transfer.search</field>
        <field name="model">intercompany.stock.transfer</field>
        <field name="arch" type="xml">
            <search string="Inter-Company Transfers">
                <field name="name"/>
                <field name="origin"/>
                <field name="line_ids" string="Product" filter_domain="[('line_ids.product_id', 'ilike', self)]"/>
                <field name="source_company_id"/>
                <field name="source_warehouse_id"/>
                <field name="dest_company_id"/>
                <field name="dest_warehouse_id"/>
                <field name="user_id"/>
                <filter name="my_transfers" string="My Transfers" domain="[('user_id', '=', uid)]"/>
                <separator/>
                <filter name="draft" string="Draft" domain="[('state', '=', 'draft')]"/>
                <filter name="confirmed" string="Confirmed" domain="[('state', '=', 'confirmed')]"/>
                <filter name="in_transit" string="In Transit" domain="[('state', '=', 'in_transit')]"/>
                <filter name="received" string="Received" domain="[('state', '=', 'received')]"/>
                <filter name="cancel" string="Cancelled" domain="[('state', '=', 'cancel')]"/>
                <separator/>
                <filter name="scheduled_date" string="Scheduled Date" date="scheduled_date"/>
                <separator/>
                <filter name="archived" string="Archived" domain="[('active', '=', False)]"/>
                <group expand="0" string="Group By">
                    <filter name="group_source_company" string="Source Company" context="{'group_by': 'source_company_id'}"/>
                    <filter name="group_source_warehouse" string="Source Warehouse" context="{'group_by': 'source_warehouse_id'}"/>
                    <filter name="group_dest_company" string="Destination Company" context="{'group_by': 'dest_company_id'}"/>
                    <filter name="group_dest_warehouse" string="Destination Warehouse" context="{'group_by': 'dest_warehouse_id'}"/>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="group_scheduled_date" string="Scheduled Date" context="{'group_by': 'scheduled_date'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_intercompany_transfer" model="ir.actions.act_window">
        <field name="name">Inter-Company Transfers</field>
        <field name="res_model">intercompany.stock.transfer</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_intercompany_transfer_search"/>
        <field name="groups_id" eval="[(4, ref('group_intercompany_transfer'))]"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create an inter-company stock transfer</p>
            <p>Move stock from a warehouse of one company to a warehouse of another company.
               Each transfer generates a delivery in the source company and, once dispatched,
               a receipt in the destination company.</p>
        </field>
    </record>
</odoo>
