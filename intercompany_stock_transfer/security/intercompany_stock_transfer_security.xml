<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Own category under "Inventory": Odoo 18 shows category-less
         (checkbox) groups only in debug mode, while category groups are
         rendered on Settings > Users > Access Rights for every administrator.
         Leaving the field empty revokes the right. -->
    <record id="module_category_intercompany_transfer" model="ir.module.category">
        <field name="name">Inter-Company Stock Transfers</field>
        <field name="parent_id" ref="base.module_category_inventory"/>
        <field name="sequence">20</field>
    </record>

    <!-- Implying Inventory/User gives the stock access the workflow needs;
         the reverse is NOT true, so plain Inventory users never get it. -->
    <record id="group_intercompany_transfer" model="res.groups">
        <field name="name">Allow Inter-Company Stock Transfers</field>
        <field name="category_id" ref="module_category_intercompany_transfer"/>
        <field name="implied_ids" eval="[(4, ref('stock.group_stock_user'))]"/>
        <field name="comment">Create, confirm, dispatch, receive and cancel stock transfers between warehouses of different companies.</field>
    </record>

    <!-- Multi-company rules. A transfer is visible when its source OR
         destination company is one the user is allowed in (user.company_ids),
         independently of what is ticked in the company switcher, so that
         transfers between companies/branches work without toggling it.
         Nothing of companies the user is not allowed in is ever visible, and
         workflow methods additionally require access to the companies they
         act on. (Replaces the former switcher-based rules.) -->
    <delete model="ir.rule" search="[('id', '=', ref('intercompany_stock_transfer.intercompany_transfer_company_rule', raise_if_not_found=False))]"/>
    <delete model="ir.rule" search="[('id', '=', ref('intercompany_stock_transfer.intercompany_transfer_line_company_rule', raise_if_not_found=False))]"/>
    <record id="intercompany_transfer_user_companies_rule" model="ir.rule">
        <field name="name">Inter-company transfer: user companies</field>
        <field name="model_id" ref="model_intercompany_stock_transfer"/>
        <field name="global" eval="True"/>
        <field name="domain_force">['|', ('source_company_id', 'in', user.company_ids.ids), ('dest_company_id', 'in', user.company_ids.ids)]</field>
    </record>
    <record id="intercompany_transfer_line_user_companies_rule" model="ir.rule">
        <field name="name">Inter-company transfer line: user companies</field>
        <field name="model_id" ref="model_intercompany_stock_transfer_line"/>
        <field name="global" eval="True"/>
        <field name="domain_force">['|', ('transfer_id.source_company_id', 'in', user.company_ids.ids), ('transfer_id.dest_company_id', 'in', user.company_ids.ids)]</field>
    </record>
</odoo>
