<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- Shared across companies: a transfer belongs to two companies. -->
    <record id="seq_intercompany_stock_transfer" model="ir.sequence">
        <field name="name">Inter-Company Stock Transfer</field>
        <field name="code">intercompany.stock.transfer</field>
        <field name="prefix">ICT/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>
</odoo>
